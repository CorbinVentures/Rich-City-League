# Public Supabase configuration required in Vercel Preview and Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential used by trusted webhook/automation routes.
# Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Public canonical site URL used for authentication and billing redirects in production.
NEXT_PUBLIC_SITE_URL=https://www.richcityhoops.com

# Stripe membership billing (server-side only except Stripe-hosted redirects).
# Checkout remains unavailable until the secret, webhook secret and all Price IDs are configured.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_RCL_PLUS_MONTHLY=
STRIPE_PRICE_RCL_PLUS_ANNUAL=
STRIPE_PRICE_ALL_ACCESS_MONTHLY=
STRIPE_PRICE_ALL_ACCESS_ANNUAL=

# RCL Network organization billing. Use live Price IDs only in Production.
# Amplify and Premier subscriptions fail closed until their Price IDs are present.
STRIPE_NETWORK_WEBHOOK_SECRET=
STRIPE_NETWORK_PORTAL_CONFIGURATION_ID=
STRIPE_PRICE_NETWORK_AMPLIFY_MONTHLY=
STRIPE_PRICE_NETWORK_PREMIER_MONTHLY=

# Optional one-time RCL Reach Boost inventory.
# Leave any Price ID blank to keep that specific one-time checkout disabled.
STRIPE_PRICE_NETWORK_EVENT_SPOTLIGHT=
STRIPE_PRICE_NETWORK_REGIONAL_FEATURE=
STRIPE_PRICE_NETWORK_STATEWIDE_FEATURE=
STRIPE_PRICE_NETWORK_SOCIAL_FEED=
STRIPE_PRICE_NETWORK_MEDIA_FEATURE=

# Server-side OpenAI configuration used by Game IQ and the automated RCL Newsroom.
OPENAI_API_KEY=
OPENAI_GAME_IQ_MODEL=
OPENAI_NEWSROOM_MODEL=gpt-6-sol

# Vercel Cron authentication. Configure the same secret in Production.
CRON_SECRET=

# Local development only.
NODE_ENV=development