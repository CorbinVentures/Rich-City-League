# Public Supabase configuration required in Vercel Preview and Production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public canonical site URL used for authentication redirects in production.
NEXT_PUBLIC_SITE_URL=https://www.rich-city-league.com

# Optional Lab API configuration (server-side only).
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_MODEL=

# Local development only.
NODE_ENV=development
