# LeagueApps server-only integration. Never expose these as NEXT_PUBLIC_ variables.
# Site ID is the number in manager.leagueapps.com/console/sites/<SITE_ID>.
LEAGUEAPPS_SITE_ID=
LEAGUEAPPS_CLIENT_ID=
# Paste the PEM private key generated from the LeagueApps .p12 private key.
# Keep the PEM server-side; Vercel environment variables are preferred.
LEAGUEAPPS_PRIVATE_KEY=
# Optional overrides; defaults match LeagueApps' documented API hosts.
LEAGUEAPPS_AUTH_BASE_URL=https://auth.leagueapps.io
LEAGUEAPPS_API_BASE_URL=https://admin.leagueapps.io

# Dedicated Public API key used by Public API v1 (schedule, teams, locations).
# Server-only. Public API requests send it as the x-api-key query parameter.
LEAGUEAPPS_PUBLIC_API_KEY=
LEAGUEAPPS_PUBLIC_API_BASE_URL=https://api.leagueapps.com
