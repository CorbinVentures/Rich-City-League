# Public browser configuration (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional server-only administrative key. Never use this in client components.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase CLI/GitHub deployment secrets (never expose in NEXT_PUBLIC_* variables)
SUPABASE_DB_PASSWORD=your_database_password_here
SUPABASE_PROJECT_ID=your_project_reference_id_here
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Runtime
NODE_ENV=development
