{
  "name": "rich-city-league",
  "version": "0.1.0",
  "description": "Rich City League - Basketball League Management & Social Platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "supabase db reset",
    "db:seed": "supabase db reset",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint",
    "test": "vitest run",
    "test:rls": "command -v supabase >/dev/null 2>&1 && supabase status >/dev/null 2>&1 || { echo 'Local Supabase is unavailable. Start it with npm run db:start before running RLS tests.' >&2; exit 1; }; supabase test db --local",
    "test:all": "npm run test && npm run test:rls",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\""
  },
  "dependencies": {
    "@supabase/auth-helpers-nextjs": "^0.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.38.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "next": "^15.5.24",
    "postcss": "^8.5.28",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.12.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^8.54.0",
    "eslint-config-next": "^15.5.24",
    "prettier": "^3.1.0",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
